<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExamOps</RootNamespace>
    <AssemblyName>examops</AssemblyName>
    <WarningsAsErrors>nullable</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.example.json" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Data\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <None Update="sql\schema.sql"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="sql\seed.sql"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="sql\smoke_test.sql"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="sql\security.sql"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="sql\rollback_phase5.sql"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>

</Project>
