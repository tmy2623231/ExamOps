{
  "ConnectionStrings": {
    "App": "Host=localhost;Port=5432;Database=examops_db;Username=examops_app;Password=<数据库密码>;SSL Mode=Disable"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LoggingRoot": "Data/logs",
  "Storage": {
    "UploadRoot": "Data/uploads",
    "ExportRoot": "Data/export",
    "TmpRoot": "Data/tmp"
  },
  "Retention": {
    "LogDays": 30,
    "ExportHours": 24,
    "TmpHours": 1
  },
  "Urls": "http://0.0.0.0:5080",
  "AllowedHosts": "*"
}
