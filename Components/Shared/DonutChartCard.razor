@inject IJSRuntime JS
@implements IAsyncDisposable

<section @ref="_root" class="ux u097-card card">
    <header class="u097-h">
        <small>@Subtitle</small>
        <b>@Title</b>
    </header>
    <div class="u097-dn">
        <svg viewBox="0 0 216 216" aria-hidden="true">
            <circle class="u097-trk" cx="108" cy="108" r="80" />
        </svg>
        <div class="u097-c" aria-live="polite">
            <small>总计</small>
            <b>0</b>
            <span>@Unit</span>
        </div>
    </div>
    <div class="u097-lg" role="group" aria-label="@Title"></div>
</section>

@code {
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Unit { get; set; } = "项";
    [Parameter] public IReadOnlyList<DonutSlice> Slices { get; set; } = [];

    private ElementReference _root;
    private IJSObjectReference? _module;
    private string _signature = "";
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        var sig = string.Join("|", Slices.Select(x => $"{x.Label}:{x.Value}:{x.ColorVar}"));
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/DonutChartCard.razor.js");
            if (_disposed) { await _module.DisposeAsync(); return; }
            _signature = sig;
            await _module.InvokeVoidAsync("mount", _root, Slices, Unit);
        }
        else if (_module is not null && _signature != sig)
        {
            _signature = sig;
            await _module.InvokeVoidAsync("mount", _root, Slices, Unit);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("dispose", _root);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }

    public sealed record DonutSlice(string Label, int Value, string ColorVar);
}
