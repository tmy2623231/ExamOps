@rendermode InteractiveServer
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="_root" class="ux u046-wrap is-closed">
    <div class="u046-scrim" aria-hidden="true"></div>
    <div class="u046-pal">
        <label class="u046-field">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" /></svg>
            <input class="u046-in" type="text" role="combobox" aria-expanded="false" aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder="搜索页面或快捷命令…" aria-label="快捷命令搜索" />
            <kbd class="u046-kbd u046-key">Ctrl K</kbd>
        </label>
        <div class="u046-body">
            <span class="u046-hl" aria-hidden="true"></span>
            <ul class="u046-list" role="listbox" aria-label="可用命令"></ul>
        </div>
        <div class="u046-foot" aria-hidden="true">
            <span><kbd class="u046-kbd">↑↓</kbd>选择</span>
            <span><kbd class="u046-kbd">↵</kbd>前往</span>
            <span class="u046-done"></span>
        </div>
    </div>
</div>

@code {
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CommandPalette>? _dotNetRef;
    private List<CommandItem> _items = [];
    private int _lastCount = -1;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.LoadAsync();
        if (CurrentUser.IsAuthenticated)
            BuildCommands();
    }

    private void BuildCommands()
    {
        var list = new List<CommandItem>
        {
            new("工作台", "运营看板", "/", "grid"),
            new("考试", "我的考试", "/exams/my", "doc")
        };
        if (CurrentUser.HasPermission(Permissions.ExamTaskCreate))
            list.Add(new("快捷操作", "极速发考向导（上传→勾选→预览发布）", "/exams/quick-publish", "bolt", "NEW"));
        if (CurrentUser.HasPermission(Permissions.DepartmentRead))
            list.Add(new("组织与权限", "部门管理与架构模板", "/org/departments", "user"));
        if (CurrentUser.HasPermission(Permissions.UserRead))
            list.Add(new("组织与权限", "用户管理", "/org/users", "user"));
        if (CurrentUser.HasPermission(Permissions.RoleAssign))
            list.Add(new("组织与权限", "角色权限", "/org/roles", "check"));
        if (CurrentUser.HasPermission(Permissions.QuestionRead))
        {
            list.Add(new("题库与组卷", "题库管理", "/content/banks", "grid"));
            list.Add(new("题库与组卷", "题目管理", "/content/questions", "doc"));
        }
        if (CurrentUser.HasPermission(Permissions.QuestionImport))
            list.Add(new("题库与组卷", "批量导入题目 (XLSX)", "/content/questions/import", "plus"));
        if (CurrentUser.HasPermission(Permissions.PaperRead))
            list.Add(new("题库与组卷", "组卷管理", "/content/papers", "doc"));
        var isCandidateOnly = CurrentUser.Roles.Count > 0 && CurrentUser.Roles.All(r => r.Code == RoleCodes.Candidate);
        if (!isCandidateOnly)
        {
            if (CurrentUser.HasPermission(Permissions.ExamTaskRead))
                list.Add(new("考试运营", "考试任务列表", "/exams/tasks", "grid"));
            if (CurrentUser.HasPermission(Permissions.ExamAssignmentRead))
                list.Add(new("考试运营", "分配管理", "/exams/assignments", "user"));
            if (CurrentUser.HasPermission(Permissions.ExamAttemptRead))
                list.Add(new("考试运营", "答卷复核队列", "/exams/reviews", "check"));
            if (CurrentUser.HasPermission(Permissions.ExamResultPublish))
                list.Add(new("考试运营", "成绩公布中心", "/exams/publication", "check"));
            if (CurrentUser.HasPermission(Permissions.ReportRead))
                list.Add(new("考试运营", "考试统计报表", "/exams/reports", "grid"));
        }
        list.Add(new("系统外观", "切换浅色 / 深色主题", "__toggle_theme__", "moon"));
        list.Add(new("账号安全", "修改密码", "/account/password", "user"));
        _items = list;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/CommandPalette.razor.js");
            if (_disposed) { await _module.DisposeAsync(); return; }
            _dotNetRef = DotNetObjectReference.Create(this);
            _lastCount = _items.Count;
            await _module.InvokeVoidAsync("init", _root, _dotNetRef, _items);
        }
        else if (_module is not null && _items.Count != _lastCount)
        {
            _lastCount = _items.Count;
            await _module.InvokeVoidAsync("updateItems", _root, _items);
        }
    }

    [JSInvokable]
    public void ExecuteCommand(string href)
    {
        if (_disposed || string.IsNullOrWhiteSpace(href) || href == "__toggle_theme__") return;
        Navigation.NavigateTo(href, forceLoad: false);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _root);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _dotNetRef?.Dispose();
    }

    public sealed record CommandItem(string Group, string Name, string Href, string Icon, string? Shortcut = null);
}
