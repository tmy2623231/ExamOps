@inject IJSRuntime JS
@implements IAsyncDisposable

<span @ref="_root" class="ux u098-odo" role="img" aria-label="@($"{Label} {Value}")"></span>

@code {
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Label { get; set; } = "";

    private ElementReference _root;
    private IJSObjectReference? _module;
    private string? _lastValue;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/OdometerNumber.razor.js");
            if (_disposed) { await _module.DisposeAsync(); return; }
            _lastValue = Value;
            await _module.InvokeVoidAsync("render", _root, Value, true);
        }
        else if (_module is not null && _lastValue != Value)
        {
            _lastValue = Value;
            await _module.InvokeVoidAsync("render", _root, Value, false);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null) return;
        try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
