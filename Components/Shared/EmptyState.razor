<div class="empty-state">
    <span class="empty-icon" aria-hidden="true"><Icon Name="@IconName" CssClass="icon-lg" /></span>
    <h3>@Title</h3>
    <p>@Description</p>
    @if (Action is not null) { @Action }
</div>

@code {
    [Parameter] public string Title { get; set; } = "暂无数据";
    [Parameter] public string Description { get; set; } = "当前条件下没有可显示的内容。";
    [Parameter] public string IconName { get; set; } = "grid";
    [Parameter] public RenderFragment? Action { get; set; }
}
