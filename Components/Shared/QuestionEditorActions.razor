<section class="card editor-actions" aria-label="题目操作">
    @if (!ReadOnly)
    {
        <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="Save"><Icon Name="check" />@(Busy ? "正在保存…" : IsNew ? "创建草稿" : "保存草稿")</button>
    }
    else if (CanCopyDraft)
    {
        <AuthorizeView Policy="@Permissions.QuestionUpdate"><button type="button" class="btn btn-primary" disabled="@Busy" @onclick="CopyDraft">@(Busy ? "正在复制…" : "复制为新草稿")</button></AuthorizeView>
    }
    @if (CanPublish)
    {
        <AuthorizeView Policy="@Permissions.QuestionPublish"><button type="button" class="btn btn-secondary" disabled="@Busy" @onclick="Publish">发布草稿</button></AuthorizeView>
    }
    @if (CanArchive)
    {
        <AuthorizeView Policy="@Permissions.QuestionUpdate"><button type="button" class="btn btn-danger" disabled="@Busy" @onclick="Archive">归档题目</button></AuthorizeView>
    }
    @if (HasDraft) { <span class="field-hint">发布的是最近一次成功保存的草稿。</span> }
</section>

@code {
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public bool ReadOnly { get; set; } = true;
    [Parameter] public bool CanCopyDraft { get; set; }
    [Parameter] public bool CanPublish { get; set; }
    [Parameter] public bool CanArchive { get; set; }
    [Parameter] public bool HasDraft { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback Save { get; set; }
    [Parameter] public EventCallback CopyDraft { get; set; }
    [Parameter] public EventCallback Publish { get; set; }
    [Parameter] public EventCallback Archive { get; set; }
}
