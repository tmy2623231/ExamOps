@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="_root" class="ux u015-wrap">
    <div class="u015-grp" role="radiogroup" aria-label="@AriaLabel">
        <span class="u015-frame" aria-hidden="true"></span>
        @foreach (var item in Options)
        {
            var isSelected = item.Key == SelectedKey;
            <button class="u015-opt" type="button" role="radio" aria-checked="@(isSelected ? "true" : "false")"
                    tabindex="@(isSelected ? 0 : -1)" @onclick="() => SelectAsync(item.Key)">
                <span class="u015-dot" aria-hidden="true"></span>
                <span class="u015-txt">
                    <b>@item.Title @if (!string.IsNullOrWhiteSpace(item.Badge)) { <em>@item.Badge</em> }</b>
                    <small>@item.Description</small>
                </span>
                @if (!string.IsNullOrWhiteSpace(item.RightText))
                {
                    <span class="u015-price"><b>@item.RightText</b></span>
                }
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public string AriaLabel { get; set; } = "选择模板";
    [Parameter] public IReadOnlyList<RadioCardOption> Options { get; set; } = [];
    [Parameter] public string SelectedKey { get; set; } = "";
    [Parameter] public EventCallback<string> SelectedKeyChanged { get; set; }

    private ElementReference _root;
    private IJSObjectReference? _module;
    private string _placedKey = "";
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/TemplateRadioCards.razor.js");
            if (_disposed) { await _module.DisposeAsync(); return; }
            _placedKey = SelectedKey;
            await _module.InvokeVoidAsync("syncFrame", _root, true);
        }
        else if (_module is not null && _placedKey != SelectedKey)
        {
            _placedKey = SelectedKey;
            await _module.InvokeVoidAsync("syncFrame", _root, false);
        }
    }

    private Task SelectAsync(string key) => SelectedKeyChanged.InvokeAsync(key);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null) return;
        try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }

    public sealed record RadioCardOption(string Key, string Title, string Description, string? Badge = null, string? RightText = null);
}
