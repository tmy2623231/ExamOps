<svg class="icon @CssClass" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "grid":
            <rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" />
            break;
        case "building":
            <path d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16" /><path d="M16 9h2a2 2 0 0 1 2 2v10M2 21h20M8 7h4M8 11h4M8 15h4M9 21v-3h3v3" />
            break;
        case "users":
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
            break;
        case "shield":
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" /><path d="m9 12 2 2 4-4" />
            break;
        case "key":
            <circle cx="7.5" cy="15.5" r="4.5" /><path d="m10.7 12.3 7.8-7.8M15 8l3 3M18 5l2 2" />
            break;
        case "logout":
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" />
            break;
        case "menu":
            <path d="M4 6h16M4 12h16M4 18h16" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" />
            break;
        case "edit":
            <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />
            break;
        case "close":
            <path d="m6 6 12 12M18 6 6 18" />
            break;
        case "check":
            <path d="m5 12 4 4L19 6" />
            break;
        case "alert":
            <path d="M10.3 3.7 2.5 17.2A2 2 0 0 0 4.2 20h15.6a2 2 0 0 0 1.7-2.8L13.7 3.7a2 2 0 0 0-3.4 0Z" /><path d="M12 9v4M12 17h.01" />
            break;
        case "arrow-left":
            <path d="m15 18-6-6 6-6" />
            break;
        case "arrow-right":
            <path d="m9 18 6-6-6-6" />
            break;
        case "arrow-up":
            <path d="m6 15 6-6 6 6" />
            break;
        case "arrow-down":
            <path d="m6 9 6 6 6-6" />
            break;
        case "paper":
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" /><path d="M14 2v6h6M8 13h8M8 17h6" />
            break;
        case "trash":
            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6M10 11v5M14 11v5" />
            break;
        case "copy":
            <rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            break;
        case "archive":
            <path d="M21 8v13H3V8M1 3h22v5H1zM10 12h4" />
            break;
        case "refresh":
            <path d="M20 7v5h-5M4 17v-5h5" /><path d="M6.1 9a7 7 0 0 1 11.6-2L20 9M4 15l2.3 2A7 7 0 0 0 18 15" />
            break;
        default:
            <circle cx="12" cy="12" r="9" />
            break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = "grid";
    [Parameter] public string? CssClass { get; set; }
}
