@page "/account/password"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject ICurrentUser CurrentUser
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<AccountPassword> Logger

<PageHeader Title="修改密码" Description="更新当前账号密码。修改后需要重新登录。" />

<section class="card card-body password-card">
    @if (!string.IsNullOrWhiteSpace(_message)) { <Alert Kind="@_kind" Message="@_message" /> }
    <EditForm Model="Input" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <div class="field">
            <label for="current-password">当前密码</label>
            <InputText id="current-password" class="input" type="password" autocomplete="current-password" @bind-Value="Input.CurrentPassword" />
            <ValidationMessage For="() => Input.CurrentPassword" class="field-error" />
        </div>
        <div class="field">
            <label for="new-password">新密码</label>
            <InputText id="new-password" class="input" type="password" autocomplete="new-password" @bind-Value="Input.NewPassword" />
            <span class="field-hint">至少 12 个字符，最多 128 个字符。</span>
            <ValidationMessage For="() => Input.NewPassword" class="field-error" />
        </div>
        <div class="field">
            <label for="confirm-password">确认新密码</label>
            <InputText id="confirm-password" class="input" type="password" autocomplete="new-password" @bind-Value="Input.ConfirmPassword" />
            <ValidationMessage For="() => Input.ConfirmPassword" class="field-error" />
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "正在保存…" : "保存新密码")</button>
            @if (_success) { <a class="btn btn-secondary" href="/login">重新登录</a> }
        </div>
    </EditForm>
</section>

@code {
    private PasswordInput Input { get; set; } = new();
    private string? _message;
    private string _kind = "info";
    private bool _busy;
    private bool _success;

    private async Task SubmitAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            if (Input.NewPassword != Input.ConfirmPassword)
            {
                _kind = "danger";
                _message = "两次输入的新密码不一致，请重新确认。";
                return;
            }
            await CurrentUser.LoadAsync();
            if (CurrentUser.Id is not { } userId) throw new InvalidOperationException("登录状态已失效。");
            var result = await AuthService.ChangePasswordAsync(userId, Input.CurrentPassword, Input.NewPassword);
            _kind = result.IsSuccess ? "success" : "danger";
            _message = result.IsSuccess ? "密码已修改，请重新登录。" : result.Error;
            _success = result.IsSuccess;
            if (_success) Input = new PasswordInput();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "修改密码失败");
            _kind = "danger";
            _message = "密码保存失败，请稍后重试。";
        }
        finally
        {
            _busy = false;
        }
    }

    public sealed class PasswordInput
    {
        [Required(ErrorMessage = "请输入当前密码")] public string CurrentPassword { get; set; } = "";
        [Required(ErrorMessage = "请输入新密码")] [StringLength(128, MinimumLength = 12, ErrorMessage = "新密码需为 12–128 个字符")] public string NewPassword { get; set; } = "";
        [Required(ErrorMessage = "请再次输入新密码")] public string ConfirmPassword { get; set; } = "";
    }
}
