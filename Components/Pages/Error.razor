@page "/Error"
@attribute [AllowAnonymous]
@layout ExamOps.Components.Layout.AuthLayout

<section class="card card-body simple-state">
    <span class="state-code">500</span>
    <h1>页面暂时无法完成请求</h1>
    <p class="muted">错误已记录。请稍后重试；如果问题持续，请联系管理员。</p>
    <a class="btn btn-primary" href="/">返回概览</a>
</section>
