<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1E3A8A" />
    <base href="/" />
    <title>ExamOps · 考试运营平台</title>
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('examops-theme');
                var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                var theme = saved === 'dark' || saved === 'light' ? saved : (prefersDark ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="css/base/variables.css?v=@ExamOps.Infra.StaticAssets.Version" />
    <link rel="stylesheet" href="css/base/reset.css?v=@ExamOps.Infra.StaticAssets.Version" />
    <link rel="stylesheet" href="css/components/components.css?v=@ExamOps.Infra.StaticAssets.Version" />
    <link rel="stylesheet" href="app.css?v=@ExamOps.Infra.StaticAssets.Version" />
    <link rel="stylesheet" href="css/pages/exam.css?v=@ExamOps.Infra.StaticAssets.Version" />
    <link rel="stylesheet" href="examops.styles.css?v=@ExamOps.Infra.StaticAssets.Version" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
